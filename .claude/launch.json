{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend (FastAPI / uvicorn)",
      "runtimeExecutable": "pipenv",
      "runtimeArgs": ["run", "stockpredict", "serve", "--host", "127.0.0.1", "--port", "8000", "--reload"],
      "port": 8000
    },
    {
      "name": "frontend (Vite)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev", "--", "--host", "127.0.0.1", "--port", "5173"],
      "port": 5173
    },
    {
      "name": "all (run_project.py — backend + frontend)",
      "runtimeExecutable": "pipenv",
      "runtimeArgs": ["run", "python", "scripts/run_project.py"],
      "port": 5173
    }
  ]
}
